# ==============================================================================
# OBX Economy & Task Platform - Environment Configuration Example
# Copy this file to .env and configure with your actual environment values.
# NEVER commit your actual .env file or bot tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/obx_economy

# ------------------------------------------------------------------------------
# Application Environment & Logging
# ------------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# OBX Core Service Configuration (Internal API)
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
OBX_CORE_API_URL=http://localhost:8000
# Alias: OBX_CORE_URL=http://localhost:8000
OBX_CORE_INTERNAL_AUTH_TOKEN=development_secret_token_123
# Alias: INTERNAL_API_TOKEN=development_secret_token_123

# ------------------------------------------------------------------------------
# OBX Tasks Service Configuration (Internal API)
# ------------------------------------------------------------------------------
TASK_SERVICE_PORT=8001

# ------------------------------------------------------------------------------
# Discord Bot Configuration (Phase 2B.1)
# ------------------------------------------------------------------------------
# Your Discord bot OAuth2 token from the Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Your Private Discord Server ID (Guild ID) for instant slash command sync
DISCORD_GUILD_ID=123456789012345678

# Discord Role ID for OBX Administrators (e.g. @OBX Admin)
DISCORD_ADMIN_ROLE_ID=987654321098765432
# Or comma-separated list of role IDs:
# DISCORD_ADMIN_ROLE_IDS=987654321098765432,112233445566778899

# Universal OBX Raider Role ID
RAID_ROLE_ID=1544870040866787428

# Join Raid Onboarding Channel ID
RAID_JOIN_CHANNEL_ID=1544870042888568893

# Optional Channel Routing Overrides (or configure via Admin Hub)
DISCORD_TASK_CHANNEL_ID=
DISCORD_AUCTION_CHANNEL_ID=
DISCORD_LEADERBOARD_CHANNEL_ID=
DISCORD_WINNERS_CHANNEL_ID=
DISCORD_ADMIN_LOG_CHANNEL_ID=

